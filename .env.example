# Backend Settings
APP_NAME="Smart Parking System API"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
DEBUG=True
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Settings
DATABASE_URL="sqlite:///./parking.db"

# Pricing Configuration (VNĐ)
HOURLY_RATE=10000
FIRST_HOUR_FREE=False
LOST_CARD_FEE=50000

# Simulation Configuration
SIMULATION_MODE=True
SIMULATION_TICK_SECONDS=2.0

# ESP32 Wi-Fi & MQTT (For Physical Hardware Deployment)
WIFI_SSID="YOUR_WIFI_SSID_HERE"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD_HERE"
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID="esp32_smart_parking"

# Vision Configuration
VISION_CAMERA_INDEX=0
VISION_CONFIDENCE_THRESHOLD=0.75
